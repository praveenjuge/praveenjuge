---
import "tailwindcss/index.css";
import { Font } from "astro:assets";
import { SITE, AUTHOR } from "./consts";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
  title = SITE.title,
  description = SITE.description,
  mosaic,
} = Astro.props;
const coverImage = mosaic
  ? `https://mosaic.praveenjuge.com/use?url=${canonicalURL}`
  : new URL("/opengraph-image.jpg", Astro.url);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR.name,
  description: SITE.description,
  url: AUTHOR.url,
  image: AUTHOR.image,
  jobTitle: "UI Designer & Developer",
  contactPoint: [
    {
      "@type": "ContactPoint",
      email: AUTHOR.email,
      contactType: "New Projects",
    },
  ],
  sameAs: [AUTHOR.url, ...Object.values(AUTHOR.social)],
};
---

<html
  lang="en"
  class="text-gray-950 antialiased bg-white [font-feature-settings:'ss02','ss03','ss09'] [touch-action:manipulation] [&_img]:bg-gray-100 [scroll-behavior:smooth] [font-family:var(--font-geist)]"
>
  <head>
    <!-- Main Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />

    <!-- Primary Meta Tags -->
    <title>{title} | {AUTHOR.name}</title>
    <meta name="title" content={title + " | " + AUTHOR.name} />
    <meta name="description" content={description} />

    <!-- Other Metadata -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={AUTHOR.name + "'s Designs"}
      href={new URL("design/rss.xml", Astro.site)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={AUTHOR.name + "'s Blog"}
      href={new URL("blog/rss.xml", Astro.site)}
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="application-name" content={SITE.title} />
    <link rel="author" href={AUTHOR.url} />
    <meta name="author" content={AUTHOR.name} />
    <meta name="keywords" content="praveen,praveenjuge,juge" />
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="#e5e7eb" />
    <meta name="creator" content={AUTHOR.name} />
    <meta name="publisher" content={AUTHOR.name} />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="category" content="UI Designer" />
    <meta name="me" content={AUTHOR.social.mastodon} />
    <meta name="me" content={AUTHOR.social.twitter} />
    <meta name="me" content={AUTHOR.social.x} />
    <meta name="me" content={AUTHOR.social.github} />
    <meta name="me" content={AUTHOR.social.instagram} />
    <meta name="me" content={AUTHOR.social.dribbble} />
    <meta name="me" content={AUTHOR.email} />
    <meta name="me" content={AUTHOR.url} />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title + " | " + AUTHOR.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1350" />
    <meta property="og:image" content={coverImage} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta property="twitter:title" content={title + " | " + AUTHOR.name} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={AUTHOR.handle} />
    <meta name="twitter:creator" content={AUTHOR.handle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image:type" content="image/jpeg" />
    <meta property="twitter:image:width" content="2400" />
    <meta property="twitter:image:height" content="1350" />
    <meta property="twitter:image" content={coverImage} />
    <meta property="twitter:url" content={canonicalURL} />

    <!-- Fonts -->
    <Font cssVariable="--font-geist" preload />
    <style is:global>
      @keyframes slide {
        to {
          transform: translateX(-69%);
        }
      }
    </style>
  </head>
  <body>
    <span
      class="-z-10 pointer-events-none absolute inset-0 h-56 w-full select-none bg-gradient-to-b from-gray-200"
      aria-hidden="true"></span>
    <header
      class="top-0 mx-auto mb-24 flex max-w-xl flex-col space-y-5 px-4 py-6 font-medium text-sm sm:items-center md:flex-row md:justify-between md:space-y-0"
    >
      <a href="/" title="Go to Home Page">
        <img src="/wordmark.svg" alt="Praveen Juge" width="132" height="28" class="bg-transparent!" />
      </a>
      <nav
        aria-label="Main Navigation"
        class="flex items-center gap-6 md:gap-4"
      >
        <a href="/design/">Designs</a>
        <a href="/blog/">Blog</a>

        <a
          title="GitHub"
          href={AUTHOR.social.github}
          target="_blank"
          rel="noopener noreferrer me"
        >
          <img src="/icons/github.svg" alt="GitHub" width="20" height="20" class="bg-transparent!" />
        </a>

        <a
          title="Dribbble"
          href={AUTHOR.social.dribbble}
          target="_blank"
          rel="noopener noreferrer me"
        >
          <img src="/icons/dribbble.svg" alt="Dribbble" width="20" height="20" class="bg-transparent!" />
        </a>
        <a
          title="X (Twitter)"
          href={AUTHOR.social.x}
          target="_blank"
          rel="noopener noreferrer me"
        >
          <img src="/icons/x.svg" alt="X (Twitter)" width="20" height="20" class="bg-transparent!" />
        </a>
        <a rel="me" href={AUTHOR.social.mastodon} style={{ display: "none" }}>
          Mastodon
        </a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="grid place-items-center py-24">
      <a href="/" title="Go to Home Page">
        <img
          src="/icons/mark.svg"
          alt="Home"
          width="50"
          height="50"
          class="bg-transparent! transition duration-1000 hover:rotate-180"
        />
      </a>
    </footer>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </body>
</html>
