---
import { Image } from "astro:assets";
import Layout from "../Layout.astro";
import { AUTHOR } from "../consts";
import { SOCIAL_LOGOS } from "../social-logos";
import myPhoto from "../images/praveenjuge.jpg";

const links: {
  name: string;
  logo: keyof typeof SOCIAL_LOGOS;
  href: string;
  handle: string;
}[] = [
  { name: "X (Twitter)", logo: "x", href: AUTHOR.social.x, handle: "@praveenjuge" },
  { name: "GitHub", logo: "github", href: AUTHOR.social.github, handle: "@praveenjuge" },
  { name: "YouTube", logo: "youtube", href: AUTHOR.social.youtube, handle: "@praveenjuge" },
  { name: "Threads", logo: "threads", href: AUTHOR.social.threads, handle: "@praveenjuge" },
  { name: "Dribbble", logo: "dribbble", href: AUTHOR.social.dribbble, handle: "@praveenjuge" },
  { name: "Behance", logo: "behance", href: AUTHOR.social.behance, handle: "@praveenjuge" },
  { name: "Figma", logo: "figma", href: AUTHOR.social.figma, handle: "@praveenjuge" },
  { name: "LinkedIn", logo: "linkedin", href: AUTHOR.social.linkedin, handle: "in/praveenjuge" },
  { name: "Instagram", logo: "instagram", href: AUTHOR.social.instagram, handle: "@praveenjuge" },
  { name: "Bluesky", logo: "bluesky", href: AUTHOR.social.bsky, handle: "@praveenjuge.com" },
  { name: "Mastodon", logo: "mastodon", href: AUTHOR.social.mastodon, handle: "@praveenjuge@mastodon.social" },
  { name: "Peerlist", logo: "peerlist", href: AUTHOR.social.peerlist, handle: "@praveenjuge" },
  { name: "npm", logo: "npm", href: AUTHOR.social.npm, handle: "~praveenjuge" },
  { name: "App Store", logo: "appStore", href: AUTHOR.social.appStore, handle: "Juge Praveen" },
  { name: "Raycast", logo: "raycast", href: AUTHOR.social.raycast, handle: "@praveenjuge" },
  { name: "Layers", logo: "layers", href: AUTHOR.social.layers, handle: "@praveenjuge" },
];
---

<Layout title="My Social Links">
  <section class="mx-auto max-w-xl space-y-8 px-4">
    <header class="flex items-center gap-4">
      <Image
        width={160}
        height={160}
        src={myPhoto}
        loading="eager"
        alt="Praveen Juge"
        class="size-16 rounded-full object-cover brightness-105"
      />
      <div>
        <h1 class="font-semibold">Praveen Juge</h1>
        <p class="opacity-60">Designer and developer. Here&rsquo;s where to find me.</p>
      </div>
    </header>

    <ul class="flex flex-col gap-2">
      {
        links.map((link) => {
          const logo = SOCIAL_LOGOS[link.logo];
          return (
            <li>
              <a href={link.href} rel="me" class="social-link" style={`--brand:${logo.color}`}>
                <svg viewBox={logo.viewBox} width="22" height="22" fill="currentColor" role="presentation" class="social-logo" set:html={logo.body} />
                <span class="min-w-0 flex-1">
                  <span class="block font-medium">{link.name}</span>
                  <span class="block truncate text-sm opacity-60">{link.handle}</span>
                </span>
                <svg
                  role="presentation"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="social-arrow shrink-0"
                >
                  <path d="m6.5 17.5 11-11m0 0h-9m9 0v9" />
                </svg>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</Layout>

<style>
  .social-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .social-logo {
    flex-shrink: 0;
    color: var(--brand);
    transition: transform 0.2s;
  }

  .social-arrow {
    opacity: 0.35;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }

  .social-link:hover,
  .social-link:focus-visible {
    border-color: color-mix(in srgb, var(--brand) 35%, white);
    background-color: color-mix(in srgb, var(--brand) 6%, white);
  }

  .social-link:hover .social-logo,
  .social-link:focus-visible .social-logo {
    transform: scale(1.08);
  }

  .social-link:hover .social-arrow,
  .social-link:focus-visible .social-arrow {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link,
    .social-logo,
    .social-arrow {
      transition: none;
    }
  }
</style>
