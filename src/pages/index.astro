---
import { Image } from "astro:assets";
import Layout from "../Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import myPhoto from "../images/praveenjuge.jpg";
import { AUTHOR } from "../consts";

const posts: CollectionEntry<"blog">[] = (await getCollection("blog"))
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
  )
  .slice(0, 10);

const designs: CollectionEntry<"design">[] = (await getCollection("design"))
  .sort(
    (a: CollectionEntry<"design">, b: CollectionEntry<"design">) =>
      (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
  )
  .slice(0, 12);
---

<Layout>
  <section class="mx-auto max-w-xl space-y-4 p-4 leading-relaxed">
    {
      /* <a
          href="mailto:hello@praveenjuge.com"
          class="inline-flex items-center gap-2 overflow-hidden rounded-full border border-emerald-100 bg-emerald-50 px-4 py-2 text-xs font-medium text-emerald-600"
        >
          <span class="size-1.5 animate-pulse rounded-full bg-emerald-700"></span>
          <span>Available for New Projects</span>
        </a> */
    }
    <Image
      width={1000}
      height={1000}
      quality={100}
      src={myPhoto}
      loading="eager"
      alt="Handsome pic of Praveen Juge"
      class="size-20 rounded-full bg-center bg-cover object-cover brightness-105"
    />

    <h1 class="font-semibold">
      What&rsquo;s up nerds? I&rsquo;m Praveen Juge, a designer and developer.
    </h1>

    <p>
      I specialize in UI design, accessibility, CSS and design systems with a
      knack for pixel-perfect outcomes. I also contribute to open-source
      projects to support the design community.
    </p>

    <p>
      Excited to collaborate with you on intriguing projects — reach out at{" "}
      <a
        href="mailto:hello@praveenjuge.com"
        class="underline decoration-2 underline-offset-1"
      >
        hello@praveenjuge.com
      </a>
    </p>
  </section>

  <section class="mx-auto max-w-xl space-y-4 px-4 py-8 leading-relaxed">
    <h2 class="font-semibold">What I work on</h2>
    <p>
      I make small tools for designers and developers. Most of them started
      because I needed something and could not find a simple version of it.
      You can find them below.
    </p>
    <p>
      I also write about design, CSS, Figma and the side projects I build.
      Read the <a class="underline" href="/blog/">blog</a> or browse my
      <a class="underline" href="/design/">design archive</a>.
    </p>
  </section>

  <section class="overflow-hidden py-16">
    <a
      href="/design/"
      class="-space-x-2 inline-flex animate-[slide_infinite_linear_60s]"
    >
      {
        designs.map((design) => (
          <Image
            width={1600}
            height={1200}
            alt={design.id}
            src={design.data.cover}
            class="even:-rotate-2 block min-h-72 w-96 min-w-96 rounded bg-cover object-cover ring-4 ring-white odd:rotate-2"
          />
        ))
      }
    </a>
  </section>

  <section class="mx-auto max-w-xl p-4">
    <h2 class="mt-6 font-semibold">Projects</h2>

    <section id="projects" class="my-6 space-y-5">
      <a
        href="https://teakvault.com"
        target="_blank"
        rel="noopener noreferrer"
        class="relative flex items-center justify-between gap-8 overflow-hidden rounded-lg border border-current/10 p-5"
      >
        <div class="flex items-center gap-4">
          <img
            src="/logos/teak.svg"
            alt="Teak logo"
            width="28"
            height="28"
            loading="lazy"
            class="size-6 shrink-0 rounded-sm object-contain !bg-transparent"
          />
          <div>
            <h3 class="font-semibold">Teak</h3>
            <p class="opacity-60">Your UI Inspirations. Finally Organized.</p>
          </div>
        </div>
        <svg
          role="presentation"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
          xmlns="http://www.w3.org/2000/svg"
          class="shrink-0"><path d="m6.5 17.5 11-11m0 0h-9m9 0v9"></path></svg
        >
      </a>

      <a
        href="https://mynaui.com"
        target="_blank"
        rel="noopener noreferrer"
        class="relative flex items-center justify-between gap-8 overflow-hidden rounded-lg border border-current/10 p-5"
      >
        <div class="flex items-center gap-4">
          <img
            src="/logos/mynaui.png"
            alt="MynaUI logo"
            width="28"
            height="28"
            loading="lazy"
            class="size-6 shrink-0 rounded-sm object-contain !bg-transparent"
          />
          <div>
            <h3 class="font-semibold">MynaUI</h3>
            <p class="opacity-60">
              TailwindCSS and shadcn/ui UI Kit for Figma and React.
            </p>
          </div>
        </div>
        <svg
          role="presentation"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
          xmlns="http://www.w3.org/2000/svg"
          class="shrink-0"><path d="m6.5 17.5 11-11m0 0h-9m9 0v9"></path></svg
        >
      </a>

      <a
        href="https://www.figma.com/community/plugin/1642487887236877076/niram-shadcn-design-system-generator"
        target="_blank"
        rel="noopener noreferrer"
        class="relative flex items-center justify-between gap-8 overflow-hidden rounded-lg border border-current/10 p-5"
      >
        <div class="flex items-center gap-4">
          <img
            src="/logos/niram.png"
            alt="Niram logo"
            width="28"
            height="28"
            loading="lazy"
            class="size-6 shrink-0 rounded-sm object-contain !bg-transparent"
          />
          <div>
            <h3 class="font-semibold">Niram</h3>
            <p class="opacity-60">
              Generate shadcn/ui design systems as Figma variables and components.
            </p>
          </div>
        </div>
        <svg
          role="presentation"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
          xmlns="http://www.w3.org/2000/svg"
          class="shrink-0"><path d="m6.5 17.5 11-11m0 0h-9m9 0v9"></path></svg
        >
      </a>

      <a
        href="https://mynaui.com/icons"
        target="_blank"
        rel="noopener noreferrer"
        class="relative flex items-start justify-between gap-8 overflow-hidden rounded-lg border border-current/10 p-5"
      >
        <div
          class="pointer-events-none absolute inset-y-0 left-0 size-full select-none bg-gradient-to-b from-white via-white sm:bg-gradient-to-r"
          aria-hidden="true"
        >
        </div>
        <div class="relative flex items-center gap-4">
          <img
            src="/logos/mynaui.png"
            alt="MynaUI Icons logo"
            width="28"
            height="28"
            loading="lazy"
            class="size-6 shrink-0 rounded-sm object-contain !bg-transparent"
          />
          <div>
            <h3 class="font-semibold">MynaUI Icons</h3>
            <p class="opacity-60">
              Beautiful open-source icons for your next project.
            </p>
          </div>
        </div>
        <div class="h-32 sm:h-0"></div>
      </a>

      <a
        href="https://vadivam.praveenjuge.com"
        target="_blank"
        rel="noopener noreferrer"
        class="relative flex items-center justify-between gap-8 overflow-hidden rounded-lg border border-current/10 p-5"
      >
        <div class="flex items-center gap-4">
          <img
            src="/logos/vadivam.svg"
            alt="Vadivam logo"
            width="28"
            height="28"
            loading="lazy"
            class="size-6 shrink-0 rounded-sm object-contain !bg-transparent"
          />
          <div>
            <h3 class="font-semibold">Vadivam</h3>
            <p class="opacity-60">
              Pixel-perfect open-source icons as SVGs and React components.
            </p>
          </div>
        </div>
        <svg
          role="presentation"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
          xmlns="http://www.w3.org/2000/svg"
          class="shrink-0"><path d="m6.5 17.5 11-11m0 0h-9m9 0v9"></path></svg
        >
      </a>

      <a
        href="https://apps.apple.com/in/app/one-hour-fcb6e1/id6756283371"
        target="_blank"
        rel="noopener noreferrer"
        class="relative flex items-center justify-between gap-8 overflow-hidden rounded-lg border border-current/10 p-5"
      >
        <div class="flex items-center gap-4">
          <img
            src="/logos/onehour.jpg"
            alt="One Hour logo"
            width="28"
            height="28"
            loading="lazy"
            class="size-6 shrink-0 rounded-sm object-contain !bg-transparent"
          />
          <div>
            <h3 class="font-semibold">One Hour</h3>
            <p class="opacity-60">
              Hourly habit tracker to help you build better habits.
            </p>
          </div>
        </div>
        <svg
          role="presentation"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
          xmlns="http://www.w3.org/2000/svg"
          class="shrink-0"><path d="m6.5 17.5 11-11m0 0h-9m9 0v9"></path></svg
        >
      </a>

      <a
        href="https://mosaic.praveenjuge.com"
        target="_blank"
        rel="noopener noreferrer"
        class="relative flex items-center justify-between gap-8 overflow-hidden rounded-lg border border-current/10 p-5"
      >
        <div class="flex items-center gap-4">
          <img
            src="/logos/mosaic.png"
            alt="Mosaic logo"
            width="28"
            height="28"
            loading="lazy"
            class="size-6 shrink-0 rounded-sm object-contain !bg-transparent"
          />
          <div>
            <h3 class="font-semibold">Mosaic</h3>
            <p class="opacity-60">
              Showcase your beautiful website in your OG images
            </p>
          </div>
        </div>
        <svg
          role="presentation"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
          xmlns="http://www.w3.org/2000/svg"
          class="shrink-0"><path d="m6.5 17.5 11-11m0 0h-9m9 0v9"></path></svg
        >
      </a>

      <a
        href={AUTHOR.social.figma}
        target="_blank"
        rel="noopener noreferrer"
        class="relative flex items-center justify-between gap-8 overflow-hidden rounded-lg border border-current/10 p-5"
      >
        <div class="flex items-center gap-4">
          <img
            src="/logos/figma.svg"
            alt="Figma Community logo"
            width="28"
            height="28"
            loading="lazy"
            class="size-6 shrink-0 rounded-sm object-contain !bg-transparent"
          />
          <div>
            <h3 class="font-semibold">Figma Community</h3>
            <p class="opacity-60">
              Where I share some free UI resources regularly.
            </p>
          </div>
        </div>
        <svg
          role="presentation"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
          xmlns="http://www.w3.org/2000/svg"
          class="shrink-0"><path d="m6.5 17.5 11-11m0 0h-9m9 0v9"></path></svg
        >
      </a>

      <a
        href={AUTHOR.social.youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="relative flex items-center justify-between gap-8 overflow-hidden rounded-lg border border-current/10 p-5"
      >
        <div class="flex items-center gap-4">
          <img
            src="/logos/youtube.png"
            alt="YouTube logo"
            width="28"
            height="28"
            loading="lazy"
            class="size-6 shrink-0 rounded-sm object-contain !bg-transparent"
          />
          <div>
            <h3 class="font-semibold">YouTube</h3>
            <p class="opacity-60">Watch how I design and build things.</p>
          </div>
        </div>
        <svg
          role="presentation"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
          xmlns="http://www.w3.org/2000/svg"
          class="shrink-0"><path d="m6.5 17.5 11-11m0 0h-9m9 0v9"></path></svg
        >
      </a>

      <a
        href="https://mynaui.com/copy"
        target="_blank"
        rel="noopener noreferrer"
        class="relative flex items-center justify-between gap-8 overflow-hidden rounded-lg border border-current/10 p-5"
      >
        <div class="flex items-center gap-4">
          <img
            src="/logos/mynaui.png"
            alt="Copy Book logo"
            width="28"
            height="28"
            loading="lazy"
            class="size-6 shrink-0 rounded-sm object-contain !bg-transparent"
          />
          <div>
            <h3 class="font-semibold">Copy Book</h3>
            <p class="opacity-60">
              Copy book is a collection of commonly used texts.
            </p>
          </div>
        </div>
        <svg
          role="presentation"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
          xmlns="http://www.w3.org/2000/svg"
          class="shrink-0"><path d="m6.5 17.5 11-11m0 0h-9m9 0v9"></path></svg
        >
      </a>
    </section>

    <h2 class="mt-20 font-semibold">
      <a href="/blog/">Blog</a>
    </h2>

    {
      posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="my-4 flex font-medium">
          {post.data.title}
        </a>
      ))
    }

    <a href="/blog/" class="flex font-medium">
      <span>Read More {" "}{"-->"}</span>
    </a>

    <h2 class="mt-20 font-semibold">Newsletter</h2>

    <p class="opacity-60 mt-1.5 mb-3">
      I send out a weekly newsletter with my learnings, project updates, videos,
      and more. Every Saturday.
    </p>

    <a
      href="https://praveenjuge.substack.com"
      target="_blank"
      rel="noopener noreferrer"
      class="relative flex font-medium items-center justify-between gap-8 overflow-hidden rounded-lg border border-current/10 p-4"
    >
      <span>Subscribe to Newsletter</span>
      <svg
        role="presentation"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        stroke-linecap="round"
        stroke-linejoin="round"
        xmlns="http://www.w3.org/2000/svg"
        class="shrink-0"><path d="m6.5 17.5 11-11m0 0h-9m9 0v9"></path></svg
      >
    </a>
  </section>
</Layout>
