---
import { getCollection, type CollectionEntry } from "astro:content";
import { AUTHOR } from "../consts";
import Layout from "../Layout.astro";

const latestPosts: CollectionEntry<"blog">[] = (await getCollection("blog"))
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
  )
  .slice(0, 5);

const linkClass =
  "underline decoration-current/30 underline-offset-4 transition-colors hover:decoration-current";
---

<Layout title="Page not found (404)" noindex>
  <section class="mx-auto max-w-xl space-y-12 p-4 leading-relaxed">
    <div class="space-y-2">
      <h1 class="font-semibold">Page not found</h1>
      <p class="text-pretty opacity-60">
        Nothing lives at <code id="missing-path"></code>. Head back{" "}
        <a href="/" class={linkClass}>home</a>, or if a link brought you here,
        let me know at{" "}
        <a href={`mailto:${AUTHOR.email}`} class={linkClass}>{AUTHOR.email}</a>.
      </p>
      <script is:inline>
        const missingPath = document.getElementById("missing-path");
        if (missingPath) missingPath.textContent = window.location.pathname;
      </script>
    </div>

    <div>
      <h2 class="font-semibold">Latest writing</h2>
      <ul class="mt-4 space-y-3">
        {
          latestPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}/`}
                class="font-medium text-pretty decoration-current/30 underline-offset-4 hover:underline"
              >
                {post.data.title}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 font-medium">
        <a href="/blog/">All posts {"-->"}</a>
        <span class="mx-2 opacity-30">/</span>
        <a href="/design/">Designs {"-->"}</a>
      </p>
    </div>
  </section>
</Layout>
